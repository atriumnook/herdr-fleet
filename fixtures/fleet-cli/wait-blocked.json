{
  "about": "A run blocked on a question exits 4",
  "argv": [
    "wait",
    "r1"
  ],
  "env": {
    "HERDR_FLEET_GROUP": "g1"
  },
  "responses": [
    {
      "status": 200,
      "body": {
        "run": {
          "id": "r1",
          "name": "worker 1",
          "role": "worker",
          "agent": "claude",
          "group": "g1",
          "paneId": "w1:p2",
          "state": "blocked",
          "lastOutput": "Allow this command?"
        }
      }
    }
  ],
  "expected": {
    "requests": [
      {
        "method": "POST",
        "path": "/api/fleet/runs/r1/wait",
        "headers": {
          "x-herdr-fleet": "1"
        },
        "body": {
          "group": "g1"
        }
      }
    ],
    "stdout": "r1  worker 1 (worker, claude)  blocked  pane w1:p2\n\nAllow this command?\n",
    "stderr": "",
    "exitCode": 4
  }
}
