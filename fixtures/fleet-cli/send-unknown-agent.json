{
  "about": "An agent the server does not know: its error, exit 1",
  "argv": [
    "send",
    "nobody",
    "hi"
  ],
  "env": {
    "HERDR_FLEET_GROUP": "g1"
  },
  "responses": [
    {
      "status": 404,
      "body": {
        "error": {
          "code": "run_not_found",
          "message": "no agent named nobody in g1"
        }
      }
    }
  ],
  "expected": {
    "requests": [
      {
        "method": "POST",
        "path": "/api/fleet/runs/nobody/send",
        "headers": {
          "x-herdr-fleet": "1"
        },
        "body": {
          "message": "hi",
          "group": "g1"
        }
      }
    ],
    "stdout": "",
    "stderr": "fleet: run_not_found: no agent named nobody in g1\n",
    "exitCode": 1
  }
}
