    "--cwd",
    "/repo",
    "--goal",
    "Find where the error is shown.",
    "--read-only",
    "--context",
    "none",
    "--done",
    "the files are named",
    "--verify",
    "none"
  ],
  "env": {
    "HERDR_FLEET_GROUP": "g1"
  },
  "responses": [
