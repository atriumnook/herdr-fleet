{
  "about": "wait prints the run and the result its agent wrote, and exits 0 when it settled",
  "argv": [
    "wait",
    "worker 1"
  ],
  "env": {
    "HERDR_FLEET_GROUP": "g1"
  },
  "responses": [
    {
      "status": 200,
      "body": {
        "run": {
          "id": "r1",
          "name": "worker 1",
          "role": "worker",
          "agent": "claude",
          "group": "g1",
          "paneId": "w1:p2",
          "state": "idle",
          "result": "## HANDOFF\nPASS\n",
          "lastOutput": "the screen"
        }
      }
    }
  ],
  "expected": {
    "requests": [
      {
        "method": "POST",
        "path": "/api/fleet/runs/worker%201/wait",
        "headers": {
          "x-herdr-fleet": "1"
        },
        "body": {
          "group": "g1"
        }
      }
    ],
    "stdout": "r1  worker 1 (worker, claude)  idle  pane w1:p2\n\n## HANDOFF\nPASS\n",
    "stderr": "",
    "exitCode": 0
  }
}
