{
  "about": "interrupt posts to the run with the group and prints it",
  "argv": [
    "interrupt",
    "r1"
  ],
  "env": {
    "HERDR_FLEET_GROUP": "g1"
  },
  "responses": [
    {
      "status": 200,
      "body": {
        "run": {
          "id": "r1",
          "name": "worker 1",
          "role": "worker",
          "agent": "claude",
          "group": "g1",
          "paneId": "w1:p2",
          "state": "working"
        }
      }
    }
  ],
  "expected": {
    "requests": [
      {
        "method": "POST",
        "path": "/api/fleet/runs/r1/interrupt",
        "headers": {
          "x-herdr-fleet": "1"
        },
        "body": {
          "group": "g1"
        }
      }
    ],
    "stdout": "r1  worker 1 (worker, claude)  working  pane w1:p2\n",
    "stderr": "",
    "exitCode": 0
  }
}
