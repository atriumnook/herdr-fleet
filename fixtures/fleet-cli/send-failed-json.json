{
  "about": "send to a run that failed exits 1; --json prints the run",
  "argv": [
    "send",
    "r1",
    "go",
    "--json"
  ],
  "env": {
    "HERDR_FLEET_GROUP": "g1"
  },
  "responses": [
    {
      "status": 200,
      "body": {
        "run": {
          "id": "r1",
          "name": "worker 1",
          "role": "worker",
          "agent": "claude",
          "group": "g1",
          "paneId": "w1:p2",
          "state": "failed",
          "lastError": "the pane is gone"
        }
      }
    }
  ],
  "expected": {
    "requests": [
      {
        "method": "POST",
        "path": "/api/fleet/runs/r1/send",
        "headers": {
          "x-herdr-fleet": "1"
        },
        "body": {
          "message": "go",
          "group": "g1"
        }
      }
    ],
    "stdout": "{\n  \"id\": \"r1\",\n  \"name\": \"worker 1\",\n  \"role\": \"worker\",\n  \"agent\": \"claude\",\n  \"group\": \"g1\",\n  \"paneId\": \"w1:p2\",\n  \"state\": \"failed\",\n  \"lastError\": \"the pane is gone\"\n}\n",
    "stderr": "",
    "exitCode": 1
  }
}
