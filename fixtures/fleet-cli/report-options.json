{
  "about": "report sends --hours, --planned-label (percent-encoded) and --cwd as the query",
  "argv": [
    "report",
    "--hours",
    "6",
    "--planned-label",
    "^phase:",
    "--cwd",
    "/repo"
  ],
  "responses": [
    {
      "status": 200,
      "body": {
        "report": "# Factory metrics"
      }
    }
  ],
  "expected": {
    "requests": [
      {
        "method": "GET",
        "path": "/api/fleet/report?cwd=%2Frepo&hours=6&planned_label=%5Ephase%3A",
        "headers": {
          "x-herdr-fleet": "1"
        }
      }
    ],
    "stdout": "# Factory metrics\n",
    "stderr": "",
    "exitCode": 0
  }
}
