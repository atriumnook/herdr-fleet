{
  "about": "With --json, wait follows replacedBy without the note, and prints only the last run",
  "argv": [
    "wait",
    "r1",
    "--json"
  ],
  "env": {
    "HERDR_FLEET_GROUP": "g1"
  },
  "responses": [
    {
      "status": 200,
      "body": {
        "run": {
          "id": "r1",
          "name": "worker 1",
          "role": "worker",
          "agent": "claude",
          "group": "g1",
          "paneId": "w1:p2",
          "state": "failed",
          "lastError": "usage limit",
          "replacedBy": "r2"
        }
      }
    },
    {
      "status": 200,
      "body": {
        "run": {
          "id": "r2",
          "name": "worker 1",
          "role": "worker",
          "agent": "codex",
          "group": "g1",
          "paneId": "w1:p2",
          "state": "idle"
        }
      }
    }
  ],
  "expected": {
    "requests": [
      {
        "method": "POST",
        "path": "/api/fleet/runs/r1/wait",
        "headers": {
          "x-herdr-fleet": "1"
        },
        "body": {
          "group": "g1"
        }
      },
      {
        "method": "POST",
        "path": "/api/fleet/runs/r2/wait",
        "headers": {
          "x-herdr-fleet": "1"
        },
        "body": {
          "group": "g1"
        }
      }
    ],
    "stdout": "{\n  \"id\": \"r2\",\n  \"name\": \"worker 1\",\n  \"role\": \"worker\",\n  \"agent\": \"codex\",\n  \"group\": \"g1\",\n  \"paneId\": \"w1:p2\",\n  \"state\": \"idle\"\n}\n",
    "stderr": "",
    "exitCode": 0
  }
}
