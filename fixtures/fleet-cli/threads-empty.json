    "threads"
  ],
  "responses": [
    {
      "status": 200,
      "body": {
        "threads": []
      }
    }
  ],
  "expected": {
    "requests": [
      {
        "method": "GET",
        "path": "/api/fleet/threads?cwd=$CWD",
