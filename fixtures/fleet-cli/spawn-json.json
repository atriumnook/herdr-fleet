{
  "about": "spawn --json prints the run as JSON",
  "argv": [
    "spawn",
    "--role",
    "worker",
    "--task",
    "t",
    "--cwd",
    "/repo",
    "--json"
  ],
  "env": {
    "HERDR_FLEET_GROUP": "g1"
  },
  "responses": [
    {
      "status": 201,
      "body": {
        "run": {
          "id": "r1",
          "name": "worker 1",
          "role": "worker",
          "agent": "claude",
          "group": "g1",
          "paneId": "w1:p2",
          "state": "working",
          "model": "sonnet"
        }
      }
    }
  ],
  "expected": {
    "requests": [
      {
        "method": "POST",
        "path": "/api/fleet/spawn",
        "headers": {
          "x-herdr-fleet": "1"
        },
        "body": {
          "role": "worker",
          "task": "t",
          "cwd": "/repo",
          "group": "g1",
          "depth": 0
        }
      }
    ],
    "stdout": "{\n  \"id\": \"r1\",\n  \"name\": \"worker 1\",\n  \"role\": \"worker\",\n  \"agent\": \"claude\",\n  \"group\": \"g1\",\n  \"paneId\": \"w1:p2\",\n  \"state\": \"working\",\n  \"model\": \"sonnet\"\n}\n",
    "stderr": "",
    "exitCode": 0
  }
}
