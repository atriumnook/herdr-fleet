{
  "about": "list --json prints the runs as JSON",
  "argv": [
    "list",
    "--json"
  ],
  "env": {
    "HERDR_FLEET_GROUP": "g1"
  },
  "responses": [
    {
      "status": 200,
      "body": {
        "runs": [
          {
            "id": "r1",
            "name": "worker 1",
            "role": "worker",
            "agent": "claude",
            "group": "g1",
            "paneId": "w1:p2",
            "state": "working"
          }
        ]
      }
    }
  ],
  "expected": {
    "requests": [
      {
        "method": "GET",
        "path": "/api/fleet/runs?group=g1",
        "headers": {
          "x-herdr-fleet": "1"
        }
      }
    ],
    "stdout": "[\n  {\n    \"id\": \"r1\",\n    \"name\": \"worker 1\",\n    \"role\": \"worker\",\n    \"agent\": \"claude\",\n    \"group\": \"g1\",\n    \"paneId\": \"w1:p2\",\n    \"state\": \"working\"\n  }\n]\n",
    "stderr": "",
    "exitCode": 0
  }
}
