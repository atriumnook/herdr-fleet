{
  "about": "A run spawned blocked on a question exits 4, and its error is printed as a note",
  "argv": [
    "spawn",
    "--role",
    "worker",
    "--task",
    "t",
    "--cwd",
    "/repo"
  ],
  "env": {
    "HERDR_FLEET_GROUP": "g1"
  },
  "responses": [
    {
      "status": 201,
      "body": {
        "run": {
          "id": "r1",
          "name": "worker 1",
          "role": "worker",
          "agent": "cursor",
          "group": "g1",
          "paneId": "w1:p2",
          "state": "blocked",
          "lastError": "cursor asks to trust the folder"
        }
      }
    }
  ],
  "expected": {
    "requests": [
      {
        "method": "POST",
        "path": "/api/fleet/spawn",
        "headers": {
          "x-herdr-fleet": "1"
        },
        "body": {
          "role": "worker",
          "task": "t",
          "cwd": "/repo",
          "group": "g1",
          "depth": 0
        }
      }
    ],
    "stdout": "r1  worker 1 (worker, cursor)  blocked  pane w1:p2\nnote: cursor asks to trust the folder\n",
    "stderr": "",
    "exitCode": 4
  }
}
