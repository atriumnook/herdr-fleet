{
  "about": "close-done prints each closed run",
  "argv": [
    "close-done"
  ],
  "env": {
    "HERDR_FLEET_GROUP": "g1"
  },
  "responses": [
    {
      "status": 200,
      "body": {
        "runs": [
          {
            "id": "r1",
            "name": "worker 1",
            "role": "worker",
            "agent": "claude",
            "group": "g1",
            "paneId": "w1:p2",
            "state": "idle"
          }
        ]
      }
    }
  ],
  "expected": {
    "requests": [
      {
        "method": "POST",
        "path": "/api/fleet/close-done",
        "headers": {
          "x-herdr-fleet": "1"
        },
        "body": {
          "group": "g1"
        }
      }
    ],
    "stdout": "closed r1  worker 1 (worker, claude)  idle  pane w1:p2\n",
    "stderr": "",
    "exitCode": 0
  }
}
