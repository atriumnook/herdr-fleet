{
  "about": "No runs prints no agents",
  "argv": [
    "list"
  ],
  "env": {
    "HERDR_FLEET_GROUP": "g1"
  },
  "responses": [
    {
      "status": 200,
      "body": {
        "runs": []
      }
    }
  ],
  "expected": {
    "requests": [
      {
        "method": "GET",
        "path": "/api/fleet/runs?group=g1",
        "headers": {
          "x-herdr-fleet": "1"
        }
      }
    ],
    "stdout": "no agents\n",
    "stderr": "",
    "exitCode": 0
  }
}
