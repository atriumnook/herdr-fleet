[
  {
    "about": "server/file-view.test.ts: file view > draws an HTML page without its scripts, loading only its pane's files, and shows any other HTML as text (the page)",
    "input": {
      "file": {
        "name": "page.html",
        "mime": "text/html",
        "kind": "html"
