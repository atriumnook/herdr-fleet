        "cache-control",
        "private, no-store"
      ],
      [
        "content-disposition",
        "inline; filename*=UTF-8''page.html"
      ],
      [
        "content-security-policy",
        "sandbox allow-same-origin; default-src 'none'; img-src data: 127.0.0.1:8787/api/fs/view/w1%3Ap1/; media-src 127.0.0.1:8787/api/fs/view/w1%3Ap1/; style-src 'unsafe-inline' 127.0.0.1:8787/api/fs/view/w1%3Ap1/; font-src data: 127.0.0.1:8787/api/fs/view/w1%3Ap1/"
